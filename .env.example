# AI tutor (optional) — powers free conversation with Kak via OpenCode Go.
# The app works fully offline without these; leave the key empty to use the
# scripted tutor. Copy this file to .env.local and restart the dev server.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash

# --- Production / multi-user ---
DATABASE_URL=postgres://kak:kak@localhost:5432/kak
JWT_SECRET=change-me-to-at-least-32-random-characters
SESSION_TTL_HOURS=8
REMEMBER_TTL_DAYS=30
APP_URL=http://localhost:3000
TRUST_PROXY=false
# Dev/e2e may raise the auth rate limit (default 10/min per IP bucket)
AUTH_RATE_LIMIT_MAX=1000
COOKIE_SECURE=true

# First-boot admin (optional): creates an admin account if none exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP — enables password reset / email verification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
