# AI tutor (optional) — powers free conversation with Kak via OpenCode Go.
# The app works fully offline without these; leave the key empty to use the
# scripted tutor. Copy this file to .env.local and restart the dev server.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash

# --- Production / multi-user ---
DATABASE_URL=postgres://kak:kak@localhost:5432/kak
JWT_SECRET=change-me-to-at-least-32-random-characters
SESSION_TTL_HOURS=8
REMEMBER_TTL_DAYS=30
APP_URL=http://localhost:3000
TRUST_PROXY=false
# AUTH_RATE_LIMIT_MAX=10 — raise for dev/e2e only; 10/min is the secure default
COOKIE_SECURE=true

# First-boot admin (optional): creates an admin account if none exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP — enables password reset / email verification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Voice (Piper sidecar) ---
# TTS_PROVIDER=piper
# PIPER_URL=http://piper:5000
# TTS_CACHE_DIR=/data/tts-cache
# TTS_DEFAULT_VOICE=id_ID-news_tts-medium
# TTS_LENGTH_SCALE=1.1
# TTS_RATE_LIMIT_MAX=60

# --- Production (docker-compose.prod.yml) ---
# Copy this into .env next to docker-compose.prod.yml (Portainer: paste the
# compose file, then set these in the stack's Environment Variables panel).
# Local Docker Desktop smoke test defaults: APP_IMAGE/PIPER_IMAGE fall back to
# locally-built kak-app:main / kak-piper:main; APP_DOMAIN=localhost.
#
# DATABASE_URL must point at the `postgres` service inside the compose network:
DATABASE_URL=postgres://kak:kak@postgres:5432/kak
JWT_SECRET=change-me-to-a-random-64-char-secret
TRUST_PROXY=true
APP_URL=https://your-domain.example
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-123
POSTGRES_USER=kak
POSTGRES_PASSWORD=kak
POSTGRES_DB=kak
APP_IMAGE=kak-app:main          # NAS: ghcr.io/<your-user>/<your-repo>/kak-app:main
PIPER_IMAGE=kak-piper:main      # NAS: ghcr.io/<your-user>/<your-repo>/kak-piper:main
APP_DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
PIPER_URL=http://piper:5000
TTS_CACHE_DIR=/data/tts-cache
# TTS_RATE_LIMIT_MAX=60
